<Window x:Class="HouseholdGoodsIS.Views.Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сообщение" Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="8" Margin="16">
        <Border.Effect>
            <DropShadowEffect Color="#33000000" BlurRadius="24" ShadowDepth="4" Direction="270" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="20,18,20,8">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="IconBorder" Width="36" Height="36" CornerRadius="18"
                            Background="{StaticResource AccentBrush}">
                        <TextBlock x:Name="IconText" Text="i" FontSize="18" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TitleText" Text="Сообщение" FontSize="20" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="320" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="20,4,20,10" FontSize="14"
                       TextWrapping="Wrap" LineHeight="21" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,8,20,18">
                <Button x:Name="NoButton" Content="Нет" Width="92" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}" Click="No_Click" />
                <Button x:Name="YesButton" Content="Да" Width="92" Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButton}" Click="Yes_Click" />
                <Button x:Name="OkButton" Content="ОК" Width="92"
                        Style="{StaticResource PrimaryButton}" Click="Ok_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
