<Window x:Class="HouseholdGoodsIS.Views.SaleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Продажа" Width="820" Height="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Grid.Row="0" Text="Продажа" Style="{StaticResource SectionTitleText}"
                   Margin="0,0,0,12" />

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Продажа">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Магазин самовывоза *" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                            <ComboBox x:Name="StoreBox" DisplayMemberPath="DisplayName" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Менеджер *" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                            <ComboBox x:Name="ManagerBox" DisplayMemberPath="FullName" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Дата продажи" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                            <DatePicker x:Name="SaleDateBox" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Статус" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                            <ComboBox x:Name="StatusBox">
                                <ComboBoxItem Content="Новая" />
                                <ComboBoxItem Content="Оплачена" />
                                <ComboBoxItem Content="Собрана" />
                                <ComboBoxItem Content="Выдана" />
                                <ComboBoxItem Content="Отменена" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Способ оплаты" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                            <ComboBox x:Name="MethodBox">
                                <ComboBoxItem Content="Карта" />
                                <ComboBoxItem Content="СБП" />
                                <ComboBoxItem Content="Наличные" />
                                <ComboBoxItem Content="Банковский перевод" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Скидка, ₽" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                            <TextBox x:Name="DiscountBox" Style="{StaticResource InputTextBox}"
                                     Text="0" TextChanged="DiscountBox_TextChanged" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,14,0,6">
                        <TextBlock Text="Товары в продаже" Style="{StaticResource SectionTitleText}" FontSize="16" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Добавить товар" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                    Click="AddItem_Click" />
                            <Button Content="Удалить" Style="{StaticResource SecondaryButton}" Click="DeleteItem_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0">
                        <DataGrid x:Name="ItemsGrid" BorderThickness="0" Height="240">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Артикул" Binding="{Binding Sku}" Width="90" />
                                <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*" />
                                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80" />
                                <DataGridTextColumn Header="Цена, ₽" Binding="{Binding UnitPrice, StringFormat={}{0:N0}}" Width="110" />
                                <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding TotalPrice, StringFormat={}{0:N0}}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <TextBlock Text="Итого:" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="TotalText" Text="0 ₽" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" Margin="10,0,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Платежи">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                        <Button Content="Добавить платёж" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                Click="AddPayment_Click" />
                        <Button Content="Удалить" Style="{StaticResource SecondaryButton}" Click="DeletePayment_Click" />
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
                        <DataGrid x:Name="PaymentsGrid" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" Binding="{Binding PaymentDate, StringFormat={}{0:dd.MM.yyyy}}" Width="110" />
                                <DataGridTextColumn Header="Способ" Binding="{Binding PaymentMethod}" Width="170" />
                                <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Amount, StringFormat={}{0:N0}}" Width="130" />
                                <DataGridTextColumn Header="Назначение" Binding="{Binding Purpose}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Content="Отмена" Width="92" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                    Click="Cancel_Click" />
            <Button Content="Сохранить" Width="110" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
