<Window x:Class="HouseholdGoodsIS.Views.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход — DENIS"
        Height="680" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/Resources/Icons/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Width="420" VerticalAlignment="Center" Style="{StaticResource CardBorder}"
                Padding="28,26" CornerRadius="8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Resources/Images/logo_icon.png" Width="48" Height="48" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DENIS" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="Учёт и продажи бытовой техники · ДНС" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Вход в систему" FontSize="24" FontWeight="SemiBold" Margin="0,24,0,4" />
                <TextBlock Text="Введите логин и пароль, выданные администратором"
                           Style="{StaticResource SecondaryText}" Margin="0,0,0,18" TextWrapping="Wrap" />

                <TextBlock Text="Логин" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                <TextBox x:Name="LoginBox" Style="{StaticResource InputTextBox}"
                         Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Пароль" Style="{StaticResource SecondaryText}" Margin="0,12,0,4" />
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPasswordBox}" />

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

                <Button Content="Войти" Height="36" Margin="0,18,0,0" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" Click="LoginButton_Click" />

                <Button Content="Проверить подключение к базе данных"
                        Style="{StaticResource LinkButton}" Height="28" FontSize="12"
                        Margin="0,10,0,0" Command="{Binding TestConnectionCommand}" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="DENIS · Ярославль · 2026" Style="{StaticResource SecondaryText}"
                   HorizontalAlignment="Center" Margin="0,0,0,18" />
    </Grid>
</Window>
