<Page x:Class="HouseholdGoodsIS.Views.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Товары" Background="Transparent">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Бытовые товары" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{Binding ProductsCountText}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Добавить" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                        Command="{Binding AddCommand}" />
                <Button Content="Изменить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Command="{Binding EditCommand}" />
                <Button Content="Удалить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Command="{Binding DeleteCommand}" />
                <Button Content="Обновить" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Поиск:" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Width="260" Style="{StaticResource InputTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Категория:" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"
                           Margin="18,0,8,0" />
                <ComboBox Width="190" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" />
                <TextBlock Text="Сортировка:" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"
                           Margin="18,0,8,0" />
                <ComboBox Width="210" ItemsSource="{Binding Sorts}" SelectedIndex="{Binding SelectedSortIndex}" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabItem Header="Карточки">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <ItemsControl ItemsSource="{Binding Products}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Width="300" Margin="0,0,16,16" Padding="12">
                                    <StackPanel>
                                        <Border Height="160" CornerRadius="2">
                                            <Border.Background>
                                                <ImageBrush Stretch="Uniform"
                                                            ImageSource="{Binding ImagePath,
                                                                Converter={StaticResource ImageConverter}}" />
                                            </Border.Background>
                                        </Border>
                                        <Grid Margin="0,10,0,0">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <TextBlock Text="{Binding CategoryName}" Style="{StaticResource SecondaryText}"
                                                   Margin="0,2,0,2" />
                                        <TextBlock Text="{Binding Manufacturer}" Style="{StaticResource SecondaryText}" />
                                        <Grid Margin="0,8,0,0">
                                            <TextBlock Text="{Binding Sku}" FontSize="12" />
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    CornerRadius="9" Padding="7,2"
                                                    Background="{Binding Stock, Converter={StaticResource StockToBrush}}">
                                                <TextBlock Text="{Binding StockText}" Foreground="White" FontSize="10.5" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding PriceText}" FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Таблица">
                <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" Margin="0,12,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Артикул" Binding="{Binding Sku}" Width="90" />
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="170" />
                        <DataGridTextColumn Header="Поставщик" Binding="{Binding SupplierName}" Width="190" />
                        <DataGridTextColumn Header="Закупка, ₽" Binding="{Binding PurchasePrice, StringFormat={}{0:N0}}" Width="105" />
                        <DataGridTextColumn Header="Цена, ₽" Binding="{Binding RetailPrice, StringFormat={}{0:N0}}" Width="100" />
                        <DataGridTextColumn Header="Остаток" Binding="{Binding Stock}" Width="80" />
                        <DataGridTextColumn Header="Гарантия" Binding="{Binding WarrantyText}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>


