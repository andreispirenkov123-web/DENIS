<Page x:Class="HouseholdGoodsIS.Views.Pages.ClientsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Клиенты" Background="Transparent">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Клиенты" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{Binding ClientsCountText}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Добавить" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                        Command="{Binding AddCommand}" />
                <Button Content="Изменить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Command="{Binding EditCommand}" />
                <Button Content="Удалить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Command="{Binding DeleteCommand}" />
                <Button Content="Обновить" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Поиск:" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Width="300" Style="{StaticResource InputTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}"
                      MouseDoubleClick="Grid_MouseDoubleClick" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*" />
                    <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="165" />
                    <DataGridTextColumn Header="Почта" Binding="{Binding Email}" Width="210" />
                    <DataGridTextColumn Header="Город" Binding="{Binding City}" Width="130" />
                    <DataGridTextColumn Header="Дисконтная карта" Binding="{Binding DiscountCard}" Width="150" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
