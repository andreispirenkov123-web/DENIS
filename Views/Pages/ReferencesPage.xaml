<Page x:Class="HouseholdGoodsIS.Views.Pages.ReferencesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Справочники" Background="Transparent">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Справочники" Style="{StaticResource PageTitleText}" Margin="0,0,0,14" />

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Категории">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBox Width="280" HorizontalAlignment="Left" Style="{StaticResource InputTextBox}"
                                 Text="{Binding CategorySearch, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Добавить" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                    Command="{Binding AddCategoryCommand}" />
                            <Button Content="Изменить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                    Command="{Binding EditCategoryCommand}" />
                            <Button Content="Удалить" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding DeleteCategoryCommand}" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
                        <DataGrid ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Категория" Binding="{Binding Name}" Width="280" />
                                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Поставщики">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBox Width="280" HorizontalAlignment="Left" Style="{StaticResource InputTextBox}"
                                 Text="{Binding SupplierSearch, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Добавить" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                    Command="{Binding AddSupplierCommand}" />
                            <Button Content="Изменить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                    Command="{Binding EditSupplierCommand}" />
                            <Button Content="Удалить" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding DeleteSupplierCommand}" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
                        <DataGrid ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Поставщик" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="ИНН" Binding="{Binding Inn}" Width="130" />
                                <DataGridTextColumn Header="Контактное лицо" Binding="{Binding ContactPerson}" Width="220" />
                                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="180" />
                                <DataGridTextColumn Header="Город" Binding="{Binding City}" Width="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
