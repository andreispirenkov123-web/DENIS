<Page x:Class="HouseholdGoodsIS.Views.Pages.SuppliesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Поставки" Background="Transparent">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Поставки товаров" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{Binding SuppliesCountText}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Добавить" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                        Command="{Binding AddCommand}" />
                <Button Content="Изменить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Command="{Binding EditCommand}" />
                <Button Content="Удалить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Command="{Binding DeleteCommand}" />
                <Button Content="Обновить" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Поиск:" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Width="300" Style="{StaticResource InputTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Статус:" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"
                           Margin="18,0,8,0" />
                <ComboBox Width="180" ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid ItemsSource="{Binding Supplies}" SelectedItem="{Binding SelectedSupply}"
                      MouseDoubleClick="Grid_MouseDoubleClick" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Накладная" Binding="{Binding InvoiceNumber}" Width="130" />
                    <DataGridTextColumn Header="Поставщик" Binding="{Binding SupplierName}" Width="*" />
                    <DataGridTextColumn Header="Менеджер" Binding="{Binding ManagerName}" Width="180" />
                    <DataGridTextColumn Header="Дата" Binding="{Binding SupplyDate, StringFormat={}{0:dd.MM.yyyy}}" Width="105" />
                    <DataGridTextColumn Header="Позиций" Binding="{Binding ItemsCount}" Width="90" />
                    <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding TotalCost, StringFormat={}{0:N0}}" Width="120" />
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="115" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
