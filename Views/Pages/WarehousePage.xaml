<Page x:Class="HouseholdGoodsIS.Views.Pages.WarehousePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Склад" Background="Transparent">
    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Склад" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="Остатки, движения товаров, оприходование и списание"
                           Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Оприходовать" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                        Command="{Binding IncomeCommand}" />
                <Button Content="Списать" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Command="{Binding WriteOffCommand}" />
                <Button Content="Обновить" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="Позиций на складе" Style="{StaticResource SecondaryText}" />
                    <TextBlock Text="{Binding Summary.ProductsCount}" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="Единиц товара" Style="{StaticResource SecondaryText}" />
                    <TextBlock Text="{Binding Summary.UnitsCount}" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="Закупочная стоимость" Style="{StaticResource SecondaryText}" />
                    <TextBlock Text="{Binding Summary.PurchaseValueText}" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="14">
                <StackPanel>
                    <TextBlock Text="Розничная стоимость" Style="{StaticResource SecondaryText}" />
                    <TextBlock Text="{Binding Summary.RetailValueText}" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Поиск:" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox Width="260" Style="{StaticResource InputTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Категория:" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"
                               Margin="16,0,8,0" />
                    <ComboBox Width="190" ItemsSource="{Binding Categories}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedCategoryItem}" />
                    <CheckBox Content="Только низкий остаток" VerticalAlignment="Center" Margin="18,0,0,0"
                              IsChecked="{Binding LowOnly}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RowsCountText}" Style="{StaticResource SecondaryText}" Margin="0,0,12,0" />
                    <Border Background="{StaticResource ErrorBrush}" CornerRadius="9" Padding="9,2"
                            VerticalAlignment="Center">
                        <TextBlock Foreground="White" FontSize="11" FontWeight="Bold">
                            <Run Text="Мало: " /><Run Text="{Binding Summary.LowStockCount}" />
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,12">
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Артикул" Binding="{Binding Sku}" Width="85" />
                    <DataGridTextColumn Header="Товар" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="165" />
                    <DataGridTextColumn Header="Остаток" Binding="{Binding Stock}" Width="80" />
                    <DataGridTextColumn Header="Мин." Binding="{Binding MinStock}" Width="65" />
                    <DataGridTextColumn Header="Закупка, ₽" Binding="{Binding PurchasePrice, StringFormat={}{0:N0}}" Width="100" />
                    <DataGridTextColumn Header="Цена, ₽" Binding="{Binding RetailPrice, StringFormat={}{0:N0}}" Width="95" />
                    <DataGridTextColumn Header="Сумма закупки" Binding="{Binding PurchaseSumText}" Width="120" />
                    <DataGridTextColumn Header="Сумма продажи" Binding="{Binding RetailSumText}" Width="120" />
                    <DataGridTextColumn Header="Статус" Binding="{Binding StockStatusText}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Движения товаров: приход, расход, корректировки"
                           Style="{StaticResource SectionTitleText}" FontSize="16" Margin="14,10,14,6" />
                <DataGrid Grid.Row="1" ItemsSource="{Binding Movements}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding DateText}" Width="95" />
                        <DataGridTextColumn Header="Тип" Binding="{Binding MovementType}" Width="120" />
                        <DataGridTextColumn Header="Документ" Binding="{Binding Document}" Width="170" />
                        <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*" />
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding QuantityText}" Width="75" />
                        <DataGridTextColumn Header="Сотрудник" Binding="{Binding UserName}" Width="150" />
                        <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="210" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>
