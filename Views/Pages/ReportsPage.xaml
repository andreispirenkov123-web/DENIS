<Page x:Class="HouseholdGoodsIS.Views.Pages.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Отчёты" Background="Transparent">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Отчёты" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="Анализ продаж бытовых товаров за период" Style="{StaticResource SecondaryText}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="С" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <DatePicker Width="140" SelectedDate="{Binding FromDate}" Margin="0,0,10,0" />
                <TextBlock Text="по" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <DatePicker Width="140" SelectedDate="{Binding ToDate}" Margin="0,0,10,0" />
                <Button Content="Сформировать" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                        Command="{Binding BuildCommand}" />
                <Button Content="Экспорт CSV" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ExportCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,14">
            <TextBlock Text="{Binding Summary}" FontSize="14" FontWeight="SemiBold" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Продажи по категориям" Style="{StaticResource SectionTitleText}"
                               Margin="16,14,16,8" />
                    <DataGrid ItemsSource="{Binding CategoryRows}" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="*" />
                            <DataGridTextColumn Header="Продаж" Binding="{Binding SalesCount}" Width="80" />
                            <DataGridTextColumn Header="Товаров" Binding="{Binding ItemsCount}" Width="80" />
                            <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding TotalSumText}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="0">
                <StackPanel>
                    <TextBlock Text="Топ товаров" Style="{StaticResource SectionTitleText}" Margin="16,14,16,8" />
                    <DataGrid ItemsSource="{Binding TopProducts}" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*" />
                            <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80" />
                            <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding TotalSumText}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0" Margin="0,14,0,0" MaxHeight="230">
            <StackPanel>
                <TextBlock Text="Топ магазинов" Style="{StaticResource SectionTitleText}" Margin="16,14,16,8" />
                <DataGrid ItemsSource="{Binding TopStores}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Магазин" Binding="{Binding StoreName}" Width="*" />
                        <DataGridTextColumn Header="Продаж" Binding="{Binding SalesCount}" Width="100" />
                        <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding TotalSumText}" Width="150" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
