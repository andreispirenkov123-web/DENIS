<Page x:Class="HouseholdGoodsIS.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Главная" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24">

            <!-- Промо-баннер -->
            <Border Background="{StaticResource AccentBrush}" CornerRadius="10" Padding="34,28" Margin="0,0,0,20">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Большой выбор техники" FontSize="34" FontWeight="Bold" />
                        <TextBlock Text="для дома и вас" FontSize="34" FontWeight="Bold" />
                        <TextBlock Text="Холодильники, стиральные машины, телевизоры, климатическая техника и многое другое"
                                   FontSize="15" Margin="0,10,0,18" MaxWidth="640" TextWrapping="Wrap" />
                        <Button Content="Перейти в каталог" Width="210" Height="42" HorizontalAlignment="Left"
                                Background="#FF1F1F1F" Foreground="{StaticResource AccentBrush}"
                                Style="{StaticResource SecondaryButton}" Click="CatalogButton_Click" />
                    </StackPanel>
                    <TextBlock Text="20 товаров · 9 категорий" FontSize="13" HorizontalAlignment="Right"
                               VerticalAlignment="Bottom" Opacity="0.75" />
                </Grid>
            </Border>

            <!-- Категории -->
            <Grid Margin="0,0,0,12">
                <TextBlock Text="Категории товаров" Style="{StaticResource SectionTitleText}" />
                <TextBlock Text="Выберите категорию, чтобы перейти в каталог" Style="{StaticResource SecondaryText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Categories}" Margin="0,0,0,20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="268" Height="86" Margin="0,0,12,12" Style="{StaticResource SecondaryButton}"
                                Click="CategoryButton_Click" Tag="{Binding Name}" Padding="16,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ProductCountText}" Style="{StaticResource SecondaryText}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Популярные товары -->
            <Grid Margin="0,0,0,12">
                <TextBlock Text="Популярные товары" Style="{StaticResource SectionTitleText}" />
                <Button Content="Смотреть весь каталог" HorizontalAlignment="Right" Style="{StaticResource LinkButton}"
                        Click="CatalogButton_Click" />
            </Grid>
            <ItemsControl ItemsSource="{Binding PopularProducts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Width="268" Margin="0,0,12,12" Padding="12">
                            <StackPanel>
                                <Border Height="150" CornerRadius="4">
                                    <Border.Background>
                                        <ImageBrush Stretch="Uniform" ImageSource="{Binding ImagePath,
                                            Converter={StaticResource ImageConverter}}" />
                                    </Border.Background>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,8,0,2" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets"
                                               Foreground="{StaticResource AccentDarkBrush}" FontSize="12" />
                                    <TextBlock Text="{Binding RatingText}" FontSize="12" Margin="4,0,3,0"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="{Binding ReviewsText}" Style="{StaticResource SecondaryText}" FontSize="11" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                                    <TextBlock Text="{Binding PriceText}" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="{Binding OldPriceText}" Style="{StaticResource SecondaryText}"
                                               FontSize="11" TextDecorations="Strikethrough" Margin="8,0,0,0"
                                               VerticalAlignment="Bottom" />
                                </StackPanel>
                                <Button Content="Купить" Height="34" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding DataContext.AddToCartCommand,
                                            RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>

