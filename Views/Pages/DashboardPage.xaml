<Page x:Class="HouseholdGoodsIS.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Главная" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,20,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,20">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,14,0" Padding="18">
                    <StackPanel>
                        <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding Stats.ProductsCount}" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Text="Товаров в каталоге" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,14,0" Padding="18">
                    <StackPanel>
                        <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding Stats.SalesCount}" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Text="Всего продаж" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,14,0" Padding="18">
                    <StackPanel>
                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding Stats.ClientsCount}" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Text="Клиентов" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding Stats.RevenueText}" FontSize="26" FontWeight="SemiBold"
                                   Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Сумма продаж" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="Продажи по статусам" Style="{StaticResource SectionTitleText}" Margin="0,0,0,16" />
                        <ItemsControl ItemsSource="{Binding StatusCounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Status}" FontSize="13" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Height="18" Width="{Binding BarHeight}"
                                                Background="{StaticResource AccentBrush}" CornerRadius="2"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="13"
                                                   FontWeight="SemiBold" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Активные продажи" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding Stats.ActiveSales}" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="Новые, оплаченные и собранные заказы"
                                   Style="{StaticResource SecondaryText}" Margin="0,4,0,16" TextWrapping="Wrap" />
                        <TextBlock Text="Сумма продаж" Style="{StaticResource SecondaryText}" />
                        <TextBlock Text="{Binding Stats.RevenueText}" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Товары с низким остатком" Style="{StaticResource SectionTitleText}"
                               Margin="16,14,16,8" />
                    <DataGrid ItemsSource="{Binding LowStock}" BorderThickness="0" MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Артикул" Binding="{Binding Sku}" Width="90" />
                            <DataGridTextColumn Header="Товар" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="180" />
                            <DataGridTextColumn Header="Остаток" Binding="{Binding Stock}" Width="90" />
                            <DataGridTextColumn Header="Цена" Binding="{Binding RetailPrice, StringFormat={}{0:N0}}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0">
                <StackPanel>
                    <TextBlock Text="Последние продажи" Style="{StaticResource SectionTitleText}"
                               Margin="16,14,16,8" />
                    <DataGrid ItemsSource="{Binding RecentSales}" BorderThickness="0" MaxHeight="240">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="55" />
                            <DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="*" />
                            <DataGridTextColumn Header="Менеджер" Binding="{Binding ManagerName}" Width="170" />
                            <DataGridTextColumn Header="Дата" Binding="{Binding SaleDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100" />
                            <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat={}{0:N0}}" Width="110" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
