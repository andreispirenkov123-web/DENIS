<Window x:Class="HouseholdGoodsIS.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HouseholdGoodsIS.ViewModels"
        xmlns:pages="clr-namespace:HouseholdGoodsIS.Views.Pages"
        Title="Бытовые товары — учёт и продажи бытовой техники"
        Height="880" Width="1440" MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/Icons/app.ico">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><pages:DashboardPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}"><pages:ProductsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SalesViewModel}"><pages:SalesPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClientsViewModel}"><pages:ClientsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SuppliesViewModel}"><pages:SuppliesPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReferencesViewModel}"><pages:ReferencesPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersViewModel}"><pages:UsersPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><pages:ReportsPage /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,20,16,16">
                    <Image Source="pack://application:,,,/Resources/Images/logo_icon.png" Width="38" Height="38" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Бытовые товары" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="HouseholdGoodsIS" Style="{StaticResource SecondaryText}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="17">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding AvatarPath, Converter={StaticResource ImageConverter}}"
                                            Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="9,0,4,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserFullName}" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding RoleName}" Style="{StaticResource SecondaryText}" FontSize="11" />
                        </StackPanel>
                        <Button Grid.Column="2" ToolTip="Выйти" Style="{StaticResource IconButton}"
                                Click="LogoutButton_Click">
                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                        </Button>
                    </Grid>
                </Border>

                <ListBox Style="{StaticResource NavListBox}"
                         ItemContainerStyle="{StaticResource NavListBoxItem}"
                         ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding SelectedPage}"
                         Margin="0,4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" Padding="24,12">
                <Grid>
                    <TextBlock Text="{Binding PageTitle}" FontSize="20" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Сменить пароль" Style="{StaticResource LinkButton}"
                                Margin="0,0,12,0" Click="ChangePassword_Click" />
                        <TextBlock Text="{Binding UserChip}" Style="{StaticResource SecondaryText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Frame Grid.Row="1" NavigationUIVisibility="Hidden"
                   Content="{Binding SelectedPage}" Background="Transparent" />
        </Grid>
    </Grid>
</Window>
