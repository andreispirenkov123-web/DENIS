<Window x:Class="HouseholdGoodsIS.Views.SupplyEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поставка" Width="820" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Grid.Row="0" Text="Поставка" Style="{StaticResource SectionTitleText}"
                   Margin="0,0,0,14" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Поставщик *" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                <ComboBox x:Name="SupplierBox" DisplayMemberPath="Name" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Менеджер *" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                <ComboBox x:Name="ManagerBox" DisplayMemberPath="FullName" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Номер накладной *" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                <TextBox x:Name="InvoiceBox" Style="{StaticResource InputTextBox}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Дата поставки" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                <DatePicker x:Name="SupplyDateBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Статус" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                <ComboBox x:Name="StatusBox">
                    <ComboBoxItem Content="Оформлена" />
                    <ComboBoxItem Content="В пути" />
                    <ComboBoxItem Content="Получена" />
                    <ComboBoxItem Content="Отменена" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="Товары в поставке" Style="{StaticResource SectionTitleText}" FontSize="16" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Добавить товар" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            Click="AddItem_Click" />
                    <Button Content="Удалить" Style="{StaticResource SecondaryButton}" Click="DeleteItem_Click" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
                <DataGrid x:Name="ItemsGrid" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Артикул" Binding="{Binding Sku}" Width="90" />
                        <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*" />
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80" />
                        <DataGridTextColumn Header="Закупка, ₽" Binding="{Binding PurchasePrice, StringFormat={}{0:N0}}" Width="120" />
                        <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding TotalPrice, StringFormat={}{0:N0}}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <TextBlock Text="Итого:" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="TotalText" Text="0 ₽" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" Margin="10,0,0,0" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Content="Отмена" Width="92" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                    Click="Cancel_Click" />
            <Button Content="Сохранить" Width="110" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
