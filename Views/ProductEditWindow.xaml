<Window x:Class="HouseholdGoodsIS.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар" Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" Text="Товар" Style="{StaticResource SectionTitleText}"
                   Margin="0,0,0,14" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Наименование *" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                <TextBox x:Name="NameBox" Style="{StaticResource InputTextBox}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Артикул *" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                <TextBox x:Name="SkuBox" Style="{StaticResource InputTextBox}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Категория *" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                <ComboBox x:Name="CategoryBox" DisplayMemberPath="Name" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Поставщик *" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                <ComboBox x:Name="SupplierBox" DisplayMemberPath="Name" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Производитель *" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                <TextBox x:Name="ManufacturerBox" Style="{StaticResource InputTextBox}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Модель *" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                <TextBox x:Name="ModelBox" Style="{StaticResource InputTextBox}" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Гарантия, мес." Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                <TextBox x:Name="WarrantyBox" Style="{StaticResource InputTextBox}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Закупочная цена, ₽ *" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                <TextBox x:Name="PurchaseBox" Style="{StaticResource InputTextBox}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Розничная цена, ₽ *" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                <TextBox x:Name="RetailBox" Style="{StaticResource InputTextBox}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Описание" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                <TextBox x:Name="DescriptionBox" Style="{StaticResource InputTextBox}" Height="52"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="9,6" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="12,22,0,0">
                <CheckBox x:Name="ActiveCheck" Content="В продаже" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="6" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Изображение (путь)" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                <TextBox x:Name="ImageBox" Style="{StaticResource InputTextBox}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Выбрать..." Style="{StaticResource SecondaryButton}"
                    Margin="10,22,0,0" Click="Browse_Click" />
        </Grid>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Content="Отмена" Width="92" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                    Click="Cancel_Click" />
            <Button Content="Сохранить" Width="110" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
