<Window x:Class="HouseholdGoodsIS.Views.StockAdjustmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Корректировка остатка" Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Grid.Row="0" Text="Корректировка остатка"
                   Style="{StaticResource SectionTitleText}" Margin="0,0,0,12" />
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="ProductText" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="StockText" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Количество *" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                <TextBox x:Name="QuantityBox" Style="{StaticResource InputTextBox}" Text="1" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Причина" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                <ComboBox x:Name="ReasonBox">
                    <ComboBoxItem Content="Инвентаризация" />
                    <ComboBoxItem Content="Брак" />
                    <ComboBoxItem Content="Возврат поставщику" />
                    <ComboBoxItem Content="Пересорт" />
                    <ComboBoxItem Content="Прочее" />
                </ComboBox>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="Комментарий" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
            <TextBox x:Name="CommentBox" Style="{StaticResource InputTextBox}" Height="54"
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="9,6" />
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Content="Отмена" Width="92" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                    Click="Cancel_Click" />
            <Button x:Name="SaveButton" Content="Оприходовать" Width="120" Style="{StaticResource PrimaryButton}"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
